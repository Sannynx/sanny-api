{
  "version": 2,
  "builds": [
    { "src": "src/index.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/login", "dest": "public/login.html" },
    { "src": "/admin", "dest": "public/admin.html" },
    { "src": "/(.*)", "dest": "src/index.js" },
    { "src": "/", "status": 308, "headers": { "Location": "/login" } }
  ]
}
